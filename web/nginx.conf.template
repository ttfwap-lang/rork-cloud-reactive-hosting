server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip settings
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Proxy API routes to Cloudflare Worker backend
    location /api/ {
        proxy_pass https://cloud-reactive-hosting-backend.rork.app/api/;
        proxy_ssl_server_name on;
        proxy_ssl_name cloud-reactive-hosting-backend.rork.app;
        proxy_set_header Host cloud-reactive-hosting-backend.rork.app;
        proxy_set_header Origin "https://69a74dtzffgz6nx9cfn77-web.rork.live";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Proxy public stats and ping
    location /public/ {
        proxy_pass https://cloud-reactive-hosting-backend.rork.app/public/;
        proxy_ssl_server_name on;
        proxy_ssl_name cloud-reactive-hosting-backend.rork.app;
        proxy_set_header Host cloud-reactive-hosting-backend.rork.app;
        proxy_set_header Origin "https://69a74dtzffgz6nx9cfn77-web.rork.live";
    }

    location /ping {
        proxy_pass https://cloud-reactive-hosting-backend.rork.app/ping;
        proxy_ssl_server_name on;
        proxy_ssl_name cloud-reactive-hosting-backend.rork.app;
        proxy_set_header Host cloud-reactive-hosting-backend.rork.app;
        proxy_set_header Origin "https://69a74dtzffgz6nx9cfn77-web.rork.live";
    }

    # Cache static assets
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
